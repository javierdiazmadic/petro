# Environment
ENV=development
DEBUG=True

# Database
DATABASE__URL=postgresql+asyncpg://petro:petro_dev_password@db:5432/petro_dev
DATABASE__ECHO=False
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20

# Redis
REDIS__URL=redis://redis:6379/0
REDIS__DB=0
REDIS__TTL_SECONDS=3600

# Celery
CELERY__BROKER_URL=redis://redis:6379/1
CELERY__RESULT_BACKEND=redis://redis:6379/2

# MLflow
MLFLOW__TRACKING_URI=http://mlflow:5000
MLFLOW__ARTIFACT_ROOT=/mlflow/artifacts

# ML Settings
ML__MODEL_PATH=models/production/price_model.pkl
ML__SCALER_PATH=models/production/scaler.pkl
ML__PREDICTION_HORIZON_DAYS=7

# NLP Settings
NLP__MODEL_SIZE=full  # full | lite
NLP__ENABLE_TRANSFORMERS=True
NLP__BERT_MODEL=bert-base-multilingual-cased
NLP__EMBEDDING_MODEL=sentence-transformers/all-MiniLM-l12-v2

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json  # json | text

# API Settings
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=True
API__CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8000"]

# GPU Settings
GPU__ENABLE=True
GPU__DEVICE=cuda:0
GPU__MEMORY_FRACTION=0.8

# Feature Engineering
FEATURES__RECALC_INTERVAL_MINUTES=15
FEATURES__CACHE_TTL_SECONDS=600

# Prediction
PREDICTION__ENABLE_EXPLAINABILITY=True
PREDICTION__BATCH_SIZE=32

# Data Connectors
CONNECTORS__BRENT__ENABLED=True
CONNECTORS__WTI__ENABLED=True
CONNECTORS__EURUSD__ENABLED=True
CONNECTORS__GEOPORTAL__ENABLED=True
CONNECTORS__RSS_NEWS__ENABLED=True
